# Environment Variables for ROR RAG Chat Application
# Copy this file to .env and fill in the values

# Services
AUTH_FRONTEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# AI_LOCAL_LLM_URL=http://host.docker.internal:11434/v1
AI_LOCAL_LLM_URL=http://localhost:11434/v1

# Database Configuration
DB_NAME=nodejs_app
DB_USER=postgres
DB_PASSWORD=postgres

# Application Environment
NODE_ENV=development

# Authentication Configuration
# Add your auth-specific environment variables here
# TODO add AUTH_* in front of auth keys
API_KEY=dev-api-key-12345-change-in-development
JWT_SECRET=your-jwt-secret-key-change-in-development
SESSION_SECRET=your-session-secret-key-change-in-development

# Optional:
# API_PORT=8000
# DOCS_PORT=8001
# ADMINER_PORT=8080
# FRONTEND_PORT=3000
